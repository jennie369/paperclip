{
  "version": "1.0.0",
  "note": "SSOT cho phát hiện vi phạm QUY TẮC TIỀN của sales-closer (mời/chấp nhận COD, hỏi hình thức thanh toán). ĐỌC bởi: payment-policy.ts (cổng pre-send ENFORCEMENT) + crypto-pattern-scanner/scripts/audit_cskh.py P-COD (MONITORING). Regex tương thích cả JavaScript lẫn Python (flag 'i'). Sửa file này = sửa CẢ 2 tầng. Không copy regex sang nơi khác.",
  "flags": "i",
  "sentence_split": "[!?\\n]+|\\.\\s",
  "allowlist": [
    "(không|chưa|ko|chẳng)\\s*(hỗ trợ|nhận|có|áp dụng|làm|ship|giao)\\s*(hàng\\s*)?(cod|khi nhận)",
    "cod[^.!?\\n]{0,30}(chưa|không|ko)\\s*(hỗ trợ|áp dụng|có)",
    "chỉ\\s*(nhận\\s*|áp dụng\\s*)?(thanh toán|chuyển khoản)\\s*trước",
    "thanh toán trước\\s*(rồi|thì)?\\s*(bên em|nhân viên|mới)"
  ],
  "violation": [
    "(chuyển khoản|ck)[^.!?\\n]{0,40}(hay|hoặc)[^.!?\\n]{0,40}(cod|momo|khi nhận|nhận hàng)",
    "(cod|momo|khi nhận hàng|nhận hàng)[^.!?\\n]{0,40}(hay|hoặc)[^.!?\\n]{0,40}(chuyển khoản|ck)",
    "(để|sẽ|em|bên em)[^.!?\\n]{0,25}(thu|nhận|lấy)\\s*(tiền\\s*)?(cod|khi\\s*(giao|nhận)\\s*hàng)",
    "(thanh toán|trả)\\s*(tiền\\s*)?khi\\s*nhận(\\s*hàng)?",
    "nhận hàng\\s*(rồi|xong)?\\s*(mới\\s*)?(thanh toán|trả tiền)",
    "ship\\s*cod\\s*(được|cho|nha|nhé|ạ)",
    "(được|có thể)\\s*(chọn\\s*)?(ship\\s*)?cod\\b",
    "(momo|ví điện tử|zalopay)[^.!?\\n]{0,30}\\?"
  ]
}
