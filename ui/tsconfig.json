{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@gem/ui": ["./src/gem/ui"],
      "@gem/ui/*": ["./src/gem/ui/*"],
      "@gem/types": ["./src/gem/types"],
      "@gem/types/*": ["./src/gem/types/*"],
      "@gem/services": ["./src/gem/services"],
      "@gem/services/*": ["./src/gem/services/*"],
      "@gem/hooks": ["./src/gem/hooks"],
      "@gem/hooks/*": ["./src/gem/hooks/*"],
      "lexical": ["./node_modules/lexical/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/gem", "src/pages/content-center", "node_modules"]
}
