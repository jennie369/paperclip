# ============================================================
# Paperclip UI — Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit .env vào git (đã gitignore)
# ============================================================

# ── Supabase (BẮT BUỘC) ─────────────────────────────────────
# Project URL từ Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon/public key (safe cho client — không phải service_role)
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Gemral frontend aliases (tuỳ chọn) ──────────────────────
# Dùng khi embed UI vào Gemral frontend thay vì standalone
# Nếu set, sẽ override VITE_SUPABASE_* ở trên
VITE_GEMRAL_SUPABASE_URL=
VITE_GEMRAL_SUPABASE_ANON_KEY=

# ── Resend (tuỳ chọn) ───────────────────────────────────────
# API key cho email campaign preview / send trong Content Pipeline
# Lấy tại: https://resend.com/api-keys
VITE_RESEND_API_KEY=re_...
